[Unit]
Description=Lecteur de nouvelle — Recovery pipeline 6h30
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=vhds
Group=vhds
WorkingDirectory=/home/vhds/NewsFeed
EnvironmentFile=/home/vhds/NewsFeed/secrets/.env
ExecStart=/home/vhds/NewsFeed/venv/bin/python \
    /home/vhds/NewsFeed/scripts/run_recovery.py
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal
SyslogIdentifier=newsfeed-recovery
